# =============================================================================
# Cerebray - Environment Variables
# Copy to backend/.env and fill in real values. Never commit .env.
# =============================================================================

# --- Server ---
PORT=8080
ENV=development
SESSION_SECRET=change-me-to-a-long-random-secret

# --- Database (PostgreSQL) ---
DATABASE_URL=postgres://cerebray:cerebray@localhost:5432/cerebray?sslmode=disable

# --- Redis ---
REDIS_URL=redis://localhost:6379

# --- Auth (Keycloak OIDC) ---
# Leave KEYCLOAK_ISSUER_URL empty for local auth mode (auto-creates admin user).
KEYCLOAK_ISSUER_URL=
KEYCLOAK_CLIENT_ID=cerebray
KEYCLOAK_CLIENT_SECRET=
# Local auth mode (active when KEYCLOAK_ISSUER_URL is empty):
LOCAL_USER_EMAIL=admin@localhost
LOCAL_USER_NAME=Local Admin

# --- AI ---
AI_ENABLED=true
ANTHROPIC_API_KEY=sk-ant-...
AI_MODEL=claude-sonnet-4-6
AI_MONTHLY_TOKEN_BUDGET=2000000

# --- App URL ---
BASE_URL=http://localhost:5173

# --- Docker Compose (docker-compose.prod.yml reads these from the repo-root .env) ---
# Set POSTGRES_PASSWORD before running `task prod:up`. Leaving it unset silently
# starts Postgres with the default password below.
POSTGRES_PASSWORD=cerebray
LISTEN_PORT=8080

# --- Vault (used by task secrets:vault) ---
VAULT_TOKEN=hvs.your-vault-token-here
# Credentials pushed to Vault for the k8s deployment. These default to the
# literal string "cerebray" if unset, so set them before running secrets:vault.
K8S_DATABASE_PASSWORD=
K8S_REDIS_PASSWORD=
